# Copy this to api.env, then enter the key locally. Never commit api.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Accounts: apply the account/photo, approval, and community migrations in order.
# Use the project's public/publishable key, NEVER a service-role/secret key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Set true only behind HTTPS; local HTTP development leaves it false.
SECURE_COOKIES=false

# Private photo storage only: set AFTER reviewing/applying the photo migration.
# This elevated key stays in the backend. NEVER use a VITE_ variable for it.
SUPABASE_SERVICE_ROLE_KEY=

