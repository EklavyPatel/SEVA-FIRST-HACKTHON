# Copy to deploy.env privately. Never commit real values or paste secrets into chat.
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
DATA_DIRECTORY=/app/data
# Required: replace with the HTTPS origin of your frontend/TLS proxy.
APP_ORIGIN=https://YOUR_DOMAIN
SECURE_COOKIES=true
ENABLE_DEMO=true
GEMINI_API_KEY=
GEMINI_MODEL=3.5-flash-lite
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

